\definecolor{moodle}{HTML}{0F6CBF}
\definecolor{cadre}{HTML}{B0B7BF}

\hypersetup{
  pdftitle={EP Manager -- \titreguide},
  pdfauthor={Sébastien Lefebvre},
  colorlinks=true, linkcolor=moodle, urlcolor=moodle
}

\pagestyle{fancy}
\fancyhf{}
\lhead{\small EP Manager -- \titreguide}
